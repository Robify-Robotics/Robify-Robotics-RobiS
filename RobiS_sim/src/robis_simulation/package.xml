<?xml version="1.0"?>
<package format="3">
  <name>robis_simulation</name>
  <version>0.1.0</version>
  <description>Standalone Gazebo, Cartographer, and move_base simulation setup for a RobiS-style four-wheel robot.</description>
  <maintainer email="robotcar@example.com">robotcar</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>teb_local_planner</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export/>
</package>
